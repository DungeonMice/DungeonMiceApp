<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/11"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.phys.dungeonmiceapp.controller.LoginController"
           stylesheets="@styles/main.css"
           styleClass="login-root">

    <VBox alignment="CENTER"
          styleClass="login-card">

        <Label text="Dungeon Mice"
               styleClass="login-title"/>

        <Label text="Acceso al sistema"
               styleClass="login-subtitle"/>

        <TextField fx:id="usernameField"
                   promptText="Usuario"/>

        <PasswordField fx:id="passwordField"
                       promptText="Contraseña"/>

        <Label fx:id="messageLabel"
               styleClass="error-label"/>

        <Button text="Iniciar Sesión"
                onAction="#handleLogin"
                styleClass="login-button"
                maxWidth="Infinity"/>

    </VBox>

</StackPane>
